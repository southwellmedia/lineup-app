# Copy to .env.local. Values come from Supabase: Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://njrnucsrbxwtomnhcavs.supabase.co
# Publishable keys are safe in the browser; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ubOmO2dugknI19ufMeKqtw_QRpdoasI
# Server only. Bypasses RLS; used for public booking. Never expose or commit it.
SUPABASE_SECRET_KEY=
# Origin of the shop websites app (apps/sites). Optional; the dashboard links to it.
SITES_URL=http://localhost:4321
# Optional. Secret salt for anonymous analytics visitor ids; defaults to the secret key.
ANALYTICS_SALT=
# Optional. Text messages via Twilio; without these, texts are logged as skipped.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number (+15551234567) or Messaging Service SID (MG...).
TWILIO_FROM=
# Only if Twilio calls a different URL than the app sees (e.g. behind a proxy).
TWILIO_WEBHOOK_URL=
# Bearer token the Supabase cron job sends to /api/cron/reminders.
CRON_SECRET=
