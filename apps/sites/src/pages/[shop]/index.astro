---
import { placeName, pageCache, pageContext } from "../../lib/page";
import ClassicHome from "../../templates/classic/Home.astro";
import ContactSheetHome from "../../templates/contact-sheet/Home.astro";

const ctx = await pageContext(Astro.params.shop, Astro.url, Astro.locals.hostMode);
if (!ctx) return new Response(null, { status: 404, statusText: "Not found" });

const { site } = ctx;
const place = placeName(site);
const title = place ? `${site.shop.name} · Barbershop in ${place}` : `${site.shop.name} · Barbershop`;
const description =
  site.shop.about ??
  `${site.shop.tagline ?? "Fades, tapers and more"}. Book online with ${site.barbers.map((b) => b.name).join(", ")}${
    place ? ` in ${place}` : ""
  }.`;

// Cache at the edge briefly; menus and hours change rarely. Previews never.
Astro.response.headers.set("cache-control", pageCache(ctx));
---

{
  site.design.template === "contact-sheet" ? (
    <ContactSheetHome ctx={ctx} title={title} description={description} />
  ) : (
    <ClassicHome ctx={ctx} title={title} description={description} />
  )
}
