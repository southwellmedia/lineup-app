---
import type { SectionProps } from "@lineup/site-kit";
import type { PageContext } from "../../lib/page";
import { initials } from "./util";

/** The film strip: an endless reel of recent work that pauses on hover. */
type Props = { ctx: PageContext; props: SectionProps["gallery"] };
const { ctx, props } = Astro.props;
const urls = props.images.flatMap((img) => {
  const url = ctx.media(img);
  return url ? [{ url, alt: img.alt }] : [];
});
// The reel needs enough frames to fill a wide screen before it loops.
const frames = urls.length ? Array.from({ length: Math.max(9, urls.length) }, (_, i) => urls[i % urls.length]!) : [];
const code = initials(ctx.site.shop.name);
const marks = frames.map((_, i) => (i % 2 ? `${12 + i}A` : `▸ ${12 + i}`));
---

{
  frames.length ? (
    <div class="strip" aria-label={props.title || "Recent work, film strip"} role="img">
      <div class="sprockets" />
      <div class="reel">
        <div class="track">
          {[0, 1].map((k) =>
            frames.map((f) => (
              <div class="cell" aria-hidden={k === 1 ? "true" : undefined}>
                <img src={f.url} alt={k === 0 ? f.alt : ""} loading="lazy" />
              </div>
            )),
          )}
        </div>
      </div>
      <div class="mono marks" aria-hidden="true">
        {marks.slice(0, 9).map((m, i) => <span>{i === 5 ? `${code}-400` : m}</span>)}
      </div>
    </div>
  ) : null
}

<style>
  .strip { margin-inline: -20px; background: var(--film); transform: rotate(-1deg); padding: 10px 0; display: flex; flex-direction: column; gap: 8px; }
  .reel { overflow: hidden; }
  .track { display: flex; gap: 10px; width: max-content; animation: roll 60s linear infinite; }
  .strip:hover .track { animation-play-state: paused; }
  @keyframes roll { to { transform: translateX(calc(-50% - 5px)); } }
  .cell { width: 150px; height: 94px; overflow: hidden; flex-shrink: 0; }
  .cell img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); transition: transform .5s var(--ease); }
  .cell:hover img { transform: scale(1.12); }
  .marks { display: flex; justify-content: space-between; padding: 0 30px; font-size: 9px; color: var(--mute); }
  @media (max-width: 520px) {
    .cell { width: 110px; height: 70px; }
  }
</style>
