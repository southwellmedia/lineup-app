---
import { heroLines, openStatus, type SectionProps } from "@lineup/site-kit";
import type { PageContext } from "../../lib/page";
import { enabledSection } from "../../lib/shop-view";
import { heroSize, price } from "./util";

type Props = { ctx: PageContext; props: SectionProps["hero"] };
const { ctx, props } = Astro.props;
const { site, base } = ctx;

const [lineOne, rest] = heroLines(site.shop.name, props);
const first = lineOne.split("");
// Both lines share one size, set so line one fills its column. A short
// second line sits beside the intro; a long one gets its own row.
const size = heroSize(lineOne);
const stacked = rest.length > 6;

const status = openStatus(site.hours, site.shop.timezone, new Date());
const place = site.shop.neighborhood ?? site.shop.address?.city ?? null;
const eyebrow = props.eyebrow || [site.barbers.length === 1 ? "Barber" : "Barbershop", place].filter(Boolean).join(" — ");
const lede = props.lede || site.shop.tagline || site.shop.about;

const reviews = enabledSection(site, "reviews");
const signature = enabledSection(site, "signature");
const servicesShown = enabledSection(site, "services") !== null;
const featured = signature?.props.serviceId
  ? site.services.find((s) => s.id === signature.props.serviceId)
  : undefined;

const photo = ctx.media(props.image);
---

<section class="hero" id="top">
  <div class="hero-grid wrap">
    <div class="name-col" style={`--name:${size};--name2:min(${size}, ${heroSize(rest)})`}>
      <div class="mono muted meta"><span>{eyebrow}</span><span>{status.text}</span></div>
      <h1 class="display first" aria-label={[lineOne, rest].filter(Boolean).join(" ")}>
        {first.map((c, i) => <span class="ch" style={`--i:${i}`} aria-hidden="true">{c}</span>)}
      </h1>
      <div class={`second-row ${rest ? "" : "solo"} ${stacked ? "stacked" : ""}`}>
        {rest ? <span class="display last" aria-hidden="true">{rest}</span> : null}
        <div class="intro">
          <svg class="swoosh" viewBox="0 0 480 28" preserveAspectRatio="none" aria-hidden="true"><path d="M4 20 C120 6 300 2 476 12" pathLength="1" /></svg>
          {lede ? <p class="lede italic">{lede}</p> : null}
          <div class="ctas">
            <a href={ctx.book()} class="btn btn-solid">Reserve a chair <span aria-hidden="true">▸</span></a>
            {
              featured ? (
                <a href={`${base}/#signature`} class="btn">
                  {featured.name} · {price(featured.priceFromCents, featured.priceToCents)}
                </a>
              ) : servicesShown ? (
                <a href={`${base}/#sheet`} class="btn">See services</a>
              ) : null
            }
          </div>
        </div>
      </div>
    </div>
    <figure class="print hero-print develop" style="--tilt:2.5deg" data-parallax="0.06">
      <div class="frame" style="aspect-ratio: 392 / 500">
        {
          photo ? (
            <img src={photo} alt={props.image?.alt || site.shop.name} style="object-position:50% 30%" fetchpriority="high" />
          ) : (
            <div class="blank" aria-hidden="true">{site.shop.name.slice(0, 1)}</div>
          )
        }
      </div>
      <figcaption>
        <span>{props.image?.alt || `${site.shop.name}${place ? `, ${place}` : ""}`}</span>
        {
          reviews?.props.rating ? (
            <span class="mono rating" style="font-style:normal;font-size:10px">
              ★ {reviews.props.rating}{reviews.props.count ? ` · ${reviews.props.count} reviews` : ""}
            </span>
          ) : null
        }
      </figcaption>
      <div class="tape" style="left:38%"></div>
    </figure>
  </div>
  <slot />
</section>

<style>
  .hero { display: flex; flex-direction: column; gap: clamp(40px, 4vw, 56px); padding-block: 36px 44px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) clamp(300px, 29vw, 420px); column-gap: 48px; align-items: start; }
  .name-col { container-type: inline-size; min-width: 0; }
  .meta { display: flex; justify-content: space-between; gap: 16px; padding-bottom: 32px; }
  .first { font-size: var(--name); font-weight: 900; display: flex; overflow: hidden; padding-top: .04em; }
  .ch { display: inline-block; animation: up 1s var(--ease) both; animation-delay: calc(120ms + var(--i) * 55ms); }
  @keyframes up { from { transform: translateY(105%); } }
  .second-row { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 44px; align-items: end; margin-top: 4px; }
  .second-row.solo, .second-row.stacked { grid-template-columns: minmax(0, 1fr); row-gap: 28px; }
  .second-row.solo { margin-top: 28px; }
  /* Pinned to the top so it sits right under line one, not at the bottom of the intro. */
  .last { font-size: var(--name2, var(--name)); font-weight: 300; line-height: .8; color: transparent; -webkit-text-stroke: 2px var(--paper); animation: wipe 1.3s .55s var(--ease) both; white-space: nowrap; align-self: start; }
  @keyframes wipe { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  .intro { display: flex; flex-direction: column; gap: 24px; padding-bottom: 14px; }
  .swoosh { width: 100%; height: 28px; overflow: visible; }
  .swoosh path { fill: none; stroke: var(--paper); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 0; animation: draw 1.1s 1.2s var(--ease) both; }
  @keyframes draw { from { stroke-dashoffset: 1; } }
  .lede { margin: 0; font-size: clamp(20px, 1.9vw, 27px); line-height: 1.28; font-weight: 300; max-width: 34ch; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero-print { margin-top: 26px; animation: drop 1.2s .3s var(--ease) both; }
  @keyframes drop { from { transform: translateY(-40px) rotate(9deg); opacity: 0; } }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; row-gap: 32px; }
    .second-row { grid-template-columns: 1fr; row-gap: 24px; }
    .hero-print { width: min(78%, 360px); justify-self: center; }
    .meta span:last-child { display: none; }
  }
  @media (max-width: 520px) {
    .second-row { grid-template-columns: auto 1fr; column-gap: 16px; }
    .intro { grid-column: 1 / -1; }
    .swoosh { display: none; }
    .rating { display: none; }
    .meta { font-size: 10px; }
  }
</style>
