---
import { formatPhone, openStatus, type SectionProps } from "@lineup/site-kit";
import type { PageContext } from "../../lib/page";
import { placeName } from "../../lib/page";

type Props = { ctx: PageContext; props: SectionProps["hero"] };
const { ctx, props } = Astro.props;
const { site } = ctx;
const place = placeName(site);
const status = openStatus(site.hours, site.shop.timezone, new Date());
const lede = props.lede || site.shop.tagline;
const eyebrow = props.eyebrow || (place ? `Barbershop · ${place}` : null);
const photo = ctx.media(props.image);
---

<section class="relative overflow-hidden">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 pb-16 pt-14 md:grid-cols-[1fr_auto] md:pt-24">
    <div class="animate-rise">
      <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-line bg-card px-3 py-1 text-sm font-semibold">
        <span class={`size-2 rounded-full ${status.open ? "bg-emerald-600" : "bg-muted"}`}></span>
        {status.text}
      </p>
      <h1 class="font-display text-[clamp(3rem,14vw,11rem)] font-black uppercase leading-[0.82] tracking-tight [overflow-wrap:anywhere]">
        {site.shop.name}
      </h1>
      {lede ? <p class="mt-5 max-w-xl font-serif text-3xl text-muted md:text-4xl">{lede}</p> : null}
      {eyebrow ? <p class="mt-3 text-sm font-semibold uppercase tracking-[0.2em] text-muted">{eyebrow}</p> : null}
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={ctx.book()}
          class="rounded-full bg-brand px-8 py-4 text-lg font-semibold text-brand-ink shadow-[4px_4px_0_0_var(--color-ink)] transition-transform hover:-translate-y-0.5"
          >Book an appointment</a
        >
        {
          site.shop.phone ? (
            <a href={`tel:${site.shop.phone}`} class="rounded-full border-2 border-ink px-8 py-4 text-lg font-semibold hover:bg-ink hover:text-paper">
              Call {formatPhone(site.shop.phone)}
            </a>
          ) : null
        }
      </div>
    </div>
    {
      photo ? (
        <img
          src={photo}
          alt={props.image?.alt || site.shop.name}
          class="aspect-[4/5] w-full max-w-sm rounded-3xl border-2 border-ink object-cover shadow-[6px_6px_0_0_var(--color-ink)] md:w-80"
          fetchpriority="high"
        />
      ) : (
        <div aria-hidden="true" class="hidden items-end md:flex">
          <div class="pole h-80 w-10 animate-pole rounded-full ring-4 ring-ink" />
        </div>
      )
    }
  </div>
</section>
