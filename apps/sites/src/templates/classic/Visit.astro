---
import { hoursTable, type SectionProps } from "@lineup/site-kit";
import type { PageContext } from "../../lib/page";
import { mapsUrl } from "../../lib/shop-view";

type Props = { ctx: PageContext; props: SectionProps["visit"] };
const { ctx, props } = Astro.props;
const { site } = ctx;
const hours = hoursTable(site.hours);
const maps = mapsUrl(site);
---

<section id="visit" class="mx-auto max-w-6xl scroll-mt-20 px-5 py-16 md:py-24">
  <h2 class="mb-10 font-display text-6xl font-black uppercase leading-none md:text-8xl">Pull up</h2>
  <div class="grid gap-8 md:grid-cols-2">
    <div class="rounded-3xl border-2 border-ink bg-card p-6">
      <h3 class="font-display text-3xl font-black uppercase">Hours</h3>
      <dl class="mt-4 divide-y divide-line">
        {
          hours.map((h) => (
            <div class="flex justify-between gap-4 py-2.5">
              <dt class="font-semibold">{h.day}</dt>
              <dd class={h.text === "Closed" ? "text-muted" : "text-right tabular-nums"}>{h.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="flex flex-col gap-5 rounded-3xl bg-ink p-6 text-paper">
      <h3 class="font-display text-3xl font-black uppercase">Find us</h3>
      {
        site.shop.address ? (
          <address class="text-2xl not-italic leading-snug">
            {site.shop.address.line}
            <br />
            {[site.shop.address.city, site.shop.address.region].filter(Boolean).join(", ")} {site.shop.address.postalCode}
          </address>
        ) : (
          <p class="text-paper/70">Address coming soon.</p>
        )
      }
      <div class="mt-auto flex flex-wrap gap-3">
        {maps ? <a href={maps} rel="noopener" class="rounded-full bg-paper px-5 py-3 font-semibold text-ink">Directions</a> : null}
        {site.shop.phone ? <a href={`tel:${site.shop.phone}`} class="rounded-full border border-paper/40 px-5 py-3 font-semibold">Call</a> : null}
        {
          site.shop.instagram ? (
            <a href={`https://www.instagram.com/${site.shop.instagram}/`} rel="noopener" class="rounded-full border border-paper/40 px-5 py-3 font-semibold">
              Instagram
            </a>
          ) : null
        }
      </div>
    </div>
  </div>
  {
    props.faqs.length ? (
      <div class="mt-12 divide-y divide-line border-y border-line">
        {props.faqs.map((f) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none justify-between gap-4 text-xl font-semibold">
              {f.q}
              <span aria-hidden="true" class="transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-lg text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    ) : null
  }
</section>
